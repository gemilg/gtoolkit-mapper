				"uid" : {
					"__type" : "uid",
					"uidString" : "oBgepJj3DQCFqhVhCLu0AQ=="
				},
				"code" : "isBlElementVisible := [ :elem | \r\t| posX posY translationFactor translationX translationY width height canvasWidth canvasHeight |\r\tposX := elem bounds position x.\r\tposY := elem bounds position y.\r\ttranslationFactor := elem parent childrenTranslationFactor.\r\ttranslationX := translationFactor x.\r\ttranslationY := translationFactor y.\r\twidth := elem bounds extent x.\r\theight := elem bounds extent y.\r\tcanvasWidth := elem parent parent measuredBounds extent x.\r\tcanvasHeight := elem parent parent measuredBounds extent y.\r\r\t(posX + width + translationX > 0 and: posX + translationX < canvasWidth)\r\t\tand:\r\t(posY + height + translationY > 0 and: posY + translationY < canvasHeight) ]"
			},
			{
				"__type" : "textSnippet",
				"children" : {
