				"code" : "aCanvassableElement\r\tchildrenDo: [ :child | \r\t\t(isBlElementVisible value: child)\r\t\t\tifTrue: [ child background: Color lightGreen ]\r\t\t\tifFalse: [ child background: Color lightGray ] ]"
			},
